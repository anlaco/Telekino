{
  "_comentario": [
    "CATÁLOGO NORMATIVO DE BLOQUES. Es la autoridad única sobre los puertos, sus",
    "tipos y su orden (spec/03-semantica-estatica.md, regla 3). Ningún otro módulo",
    "puede decidir esta información.",
    "",
    "Extraído del registro de la implementación en Red el 2026-07-28 ejecutándolo,",
    "no transcrito a mano. Las diferencias respecto a aquel registro están en",
    "spec/04-semantica-dinamica.md §3.",
    "",
    "`{\"var\": \"E\"}` es una variable de tipo. Sólo aparece aquí, nunca en un .qvi:",
    "se liga al resolver tipos hacia delante (03-semantica-estatica.md §3.6).",
    "El orden de `in` y `out` es significativo: fija el orden de los terminales."
  ],

  "version": 1,

  "blocks": {

    "const":       { "cat": "input",  "desc": "Constante numérica",
                     "in": [], "out": [{ "name": "result", "type": "number" }],
                     "config": { "default": { "type": "number", "value": 0.0 } } },

    "str-const":   { "cat": "input",  "desc": "Constante de cadena",
                     "in": [], "out": [{ "name": "result", "type": "string" }],
                     "config": { "default": { "type": "string", "value": "" } } },

    "bool-const":  { "cat": "input",  "desc": "Constante booleana",
                     "in": [], "out": [{ "name": "result", "type": "boolean" }],
                     "config": { "default": { "type": "boolean", "value": false } } },

    "arr-const":   { "cat": "input",  "desc": "Constante de array",
                     "in": [], "out": [{ "name": "result", "type": { "var": "E" } }],
                     "config": { "type": { "kind": "dataType", "restrict": "array" },
                                 "default": { "type": "as-declared" } } },

    "control":     { "cat": "input",  "desc": "Terminal de un control numérico del panel",
                     "in": [], "out": [{ "name": "result", "type": "number" }],
                     "panel": true },
    "str-control": { "cat": "input",  "desc": "Terminal de un control de cadena",
                     "in": [], "out": [{ "name": "result", "type": "string" }],
                     "panel": true },
    "bool-control":{ "cat": "input",  "desc": "Terminal de un control booleano",
                     "in": [], "out": [{ "name": "result", "type": "boolean" }],
                     "panel": true },
    "arr-control": { "cat": "input",  "desc": "Terminal de un control de array",
                     "in": [], "out": [{ "name": "result", "type": { "var": "E" } }],
                     "panel": true, "type-from": "panel" },
    "cluster-control": { "cat": "cluster", "desc": "Terminal de un control de cluster",
                     "in": [], "out": [{ "name": "result", "type": { "var": "C" } }],
                     "panel": true, "type-from": "panel" },

    "indicator":     { "cat": "output", "desc": "Terminal de un indicador numérico",
                     "in": [{ "name": "value", "type": "number" }], "out": [],
                     "panel": true, "side-effect": true },
    "str-indicator": { "cat": "output", "desc": "Terminal de un indicador de cadena",
                     "in": [{ "name": "value", "type": "string" }], "out": [],
                     "panel": true, "side-effect": true },
    "bool-indicator":{ "cat": "output", "desc": "Terminal de un indicador booleano",
                     "in": [{ "name": "value", "type": "boolean" }], "out": [],
                     "panel": true, "side-effect": true },
    "arr-indicator": { "cat": "output", "desc": "Terminal de un indicador de array",
                     "in": [{ "name": "value", "type": { "array": { "var": "E" } } }], "out": [],
                     "panel": true, "side-effect": true },
    "cluster-indicator": { "cat": "cluster", "desc": "Terminal de un indicador de cluster",
                     "in": [{ "name": "value", "type": { "var": "C" } }], "out": [],
                     "panel": true, "type-from": "panel", "side-effect": true },

    "display":     { "cat": "output", "desc": "Imprime un valor por la salida estándar",
                     "in": [{ "name": "value", "type": "number" }], "out": [],
                     "side-effect": true },

    "add": { "cat": "math", "desc": "Suma",
             "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
             "out": [{ "name": "result", "type": "number" }] },
    "sub": { "cat": "math", "desc": "Resta",
             "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
             "out": [{ "name": "result", "type": "number" }] },
    "mul": { "cat": "math", "desc": "Multiplicación",
             "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
             "out": [{ "name": "result", "type": "number" }] },
    "div": { "cat": "math", "desc": "División. Ver 04 §6 para división por cero",
             "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
             "out": [{ "name": "result", "type": "number" }] },

    "and-op": { "cat": "logic", "desc": "Y lógico",
                "in": [{ "name": "a", "type": "boolean" }, { "name": "b", "type": "boolean" }],
                "out": [{ "name": "result", "type": "boolean" }] },
    "or-op":  { "cat": "logic", "desc": "O lógico",
                "in": [{ "name": "a", "type": "boolean" }, { "name": "b", "type": "boolean" }],
                "out": [{ "name": "result", "type": "boolean" }] },
    "not-op": { "cat": "logic", "desc": "Negación",
                "in": [{ "name": "a", "type": "boolean" }],
                "out": [{ "name": "result", "type": "boolean" }] },

    "gt-op": { "cat": "compare", "desc": "Mayor que",
               "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
               "out": [{ "name": "result", "type": "boolean" }] },
    "lt-op": { "cat": "compare", "desc": "Menor que",
               "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
               "out": [{ "name": "result", "type": "boolean" }] },
    "eq-op": { "cat": "compare", "desc": "Igualdad",
               "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
               "out": [{ "name": "result", "type": "boolean" }] },

    "concat":     { "cat": "string", "desc": "Concatena dos cadenas",
                    "in": [{ "name": "a", "type": "string" }, { "name": "b", "type": "string" }],
                    "out": [{ "name": "result", "type": "string" }] },
    "str-length": { "cat": "string", "desc": "Longitud de una cadena",
                    "in": [{ "name": "a", "type": "string" }],
                    "out": [{ "name": "result", "type": "number" }] },
    "to-string":  { "cat": "string", "desc": "Convierte un número a cadena. Ver 04 §6: el formato es comportamiento observable",
                    "in": [{ "name": "a", "type": "number" }],
                    "out": [{ "name": "result", "type": "string" }] },

    "build-array":  { "cat": "array", "desc": "Construye un array con dos elementos",
                      "in": [{ "name": "a", "type": { "var": "E" } }, { "name": "b", "type": { "var": "E" } }],
                      "out": [{ "name": "result", "type": { "array": { "var": "E" } } }] },
    "index-array":  { "cat": "array", "desc": "Elemento en la posición dada. Ver 04 §6 para índice fuera de rango",
                      "in": [{ "name": "arr", "type": { "array": { "var": "E" } } },
                             { "name": "index", "type": "number" }],
                      "out": [{ "name": "result", "type": { "var": "E" } }] },
    "array-size":   { "cat": "array", "desc": "Número de elementos",
                      "in": [{ "name": "arr", "type": { "array": { "var": "E" } } }],
                      "out": [{ "name": "result", "type": "number" }] },
    "array-subset": { "cat": "array", "desc": "Sub-array desde una posición y con una longitud",
                      "in": [{ "name": "arr", "type": { "array": { "var": "E" } } },
                             { "name": "start", "type": "number" },
                             { "name": "length", "type": "number" }],
                      "out": [{ "name": "result", "type": { "array": { "var": "E" } } }] },

    "bundle":   { "cat": "cluster", "desc": "Agrupa valores en un cluster. Un puerto de entrada por campo",
                  "in": "dynamic:cluster-fields", "out": [{ "name": "result", "type": { "var": "C" } }],
                  "dynamic-ports": true, "type-from": "config" },
    "unbundle": { "cat": "cluster", "desc": "Descompone un cluster. Un puerto de salida por campo",
                  "in": [{ "name": "value", "type": { "var": "C" } }], "out": "dynamic:cluster-fields",
                  "dynamic-ports": true, "type-from": "config" },

    "subvi": { "cat": "function", "desc": "Invoca otro VI. Sus puertos son el connector del VI llamado",
               "in": "dynamic:connector-inputs", "out": "dynamic:connector-outputs",
               "dynamic-ports": true, "config": { "vi": { "type": "string" } } },

    "while-loop":     { "cat": "structure", "desc": "Repite el cuerpo hasta que la condición es cierta",
                        "structure": true, "terminals": { "i": "number", "condition": "boolean" } },
    "for-loop":       { "cat": "structure", "desc": "Repite el cuerpo un número fijo de veces",
                        "structure": true, "terminals": { "i": "number", "count": "number" } },
    "case-structure": { "cat": "structure", "desc": "Ejecuta el marco que corresponde al selector",
                        "structure": true, "terminals": { "selector": ["number", "boolean", "string"] } },

    "tcp-open":  { "cat": "hardware", "desc": "Abre una conexión TCP. Requiere la capacidad `tcp`",
                   "in": [{ "name": "address", "type": "string", "default": "localhost" },
                          { "name": "remote-port", "type": "number", "default": 5000 },
                          { "name": "timeout-ms", "type": "number", "default": 60000 }],
                   "out": [{ "name": "connection-out", "type": "tcp-connection" }],
                   "side-effect": true, "capability": "tcp" },
    "tcp-write": { "cat": "hardware", "desc": "Escribe datos en una conexión abierta",
                   "in": [{ "name": "connection-in", "type": "tcp-connection" },
                          { "name": "data", "type": "string", "default": "" }],
                   "out": [{ "name": "connection-out", "type": "tcp-connection" },
                           { "name": "bytes-written", "type": "number" }],
                   "side-effect": true, "capability": "tcp" },
    "tcp-read":  { "cat": "hardware", "desc": "Lee datos de una conexión abierta. Operación BLOQUEANTE: ver 04 §7",
                   "in": [{ "name": "connection-in", "type": "tcp-connection" },
                          { "name": "bytes-to-read", "type": "number", "default": 256 },
                          { "name": "timeout-ms", "type": "number", "default": 60000 }],
                   "out": [{ "name": "connection-out", "type": "tcp-connection" },
                           { "name": "data", "type": "string" },
                           { "name": "bytes-read", "type": "number" }],
                   "side-effect": true, "blocking": true, "capability": "tcp" },
    "tcp-close": { "cat": "hardware", "desc": "Cierra una conexión",
                   "in": [{ "name": "connection-in", "type": "tcp-connection" }],
                   "out": [{ "name": "connection-out", "type": "tcp-connection" }],
                   "side-effect": true, "capability": "tcp" }
  },

  "no-implementados": {
    "_nota": [
      "Estos bloques existen en el registro de Red y están marcados como completados",
      "en su documentación, pero NO tienen implementación: no declaran emit y el",
      "compilador genera para ellos un lienzo vacío que nunca se actualiza.",
      "Ver whitelist.md §9. No se especifican hasta que se decida implementarlos."
    ],
    "waveform-chart": { "cat": "output", "desc": "Osciloscopio con buffer circular. SIN IMPLEMENTAR" },
    "waveform-graph": { "cat": "output", "desc": "Gráfica de un array completo. SIN IMPLEMENTAR" }
  },

  "retirados": {
    "_nota": "Bloques del registro de Red que no pasan a la especificación nueva.",
    "iter": "Era un pseudo-bloque para el contador de iteración. Sustituido por el terminal `estructura.i`, que no necesita ser un nodo."
  }
}
