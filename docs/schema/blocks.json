{
  "_comentario": [
    "CATÁLOGO NORMATIVO DE BLOQUES. Es la autoridad única sobre los puertos, sus",
    "tipos y su orden (spec/03-semantica-estatica.md, regla 3). Ningún otro módulo",
    "puede decidir esta información.",
    "",
    "Extraído del registro de la implementación en Red el 2026-07-28 ejecutándolo,",
    "no transcrito a mano. Las diferencias respecto a aquel registro están en",
    "spec/04-semantica-dinamica.md §3.",
    "",
    "`{\"var\": \"E\"}` es una variable de tipo. Sólo aparece aquí, nunca en un .qvi:",
    "se liga al resolver tipos hacia delante (03-semantica-estatica.md §3.6).",
    "El orden de `in` y `out` es significativo: fija el orden de los terminales.",
    "",
    "`{\"num\": \"N\"}` es una variable de tipo NUMÉRICA (DT-038): las entradas que",
    "la comparten toman el tipo común de lo que se les cablee, con la regla de",
    "conversión de LabVIEW, y las salidas que la llevan salen de ese tipo. Con",
    "`\"flotante\": true`, si el tipo común es entero la salida es DBL. `label` es",
    "el nombre del terminal en LabVIEW, el que enseña su tip strip.",
    "",
    "`entradas` (compound-arithmetic): puertos de entrada que fija `config.inputs`,",
    "`value-0`, `value-1`… (spec/03 §4.3). En los `modos-bit-a-bit` la operación es",
    "entera: un N de coma flotante pasa al entero de sus mismos bits (DBL a I64, SGL",
    "a I32) y las entradas de coma flotante llevan punto de coerción. Con booleanos",
    "cableados opera sobre booleanos, como cuando sale de la paleta Boolean.",
    "",
    "`{\"logico\": \"L\"}` es una variable de tipo LÓGICA (las funciones de Boolean):",
    "liga booleano o numérico. Sin nada cableado vale booleano; con enteros la",
    "operación es bit a bit, y la coma flotante pasa al entero de sus mismos bits",
    "(DBL a I64, SGL a I32) con punto de coerción, como en los modos bit a bit de",
    "Compound Arithmetic. Comprobado en LabVIEW 2026 Q3 cableando un DBL a And."
  ],

  "version": 1,

  "blocks": {

    "const":       { "cat": "input",  "desc": "Constante numérica DBL (la DBL Numeric Constant de LabVIEW)",
                     "in": [], "out": [{ "name": "result", "type": "number" }],
                     "config": { "default": { "type": "number", "value": 0.0 } } },

    "str-const":   { "cat": "input",  "desc": "Constante de cadena",
                     "in": [], "out": [{ "name": "result", "type": "string" }],
                     "config": { "default": { "type": "string", "value": "" } } },

    "bool-const":  { "cat": "input",  "desc": "Constante booleana",
                     "in": [], "out": [{ "name": "result", "type": "boolean" }],
                     "config": { "default": { "type": "boolean", "value": false } } },

    "arr-const":   { "cat": "input",  "desc": "Constante de array",
                     "in": [], "out": [{ "name": "result", "type": { "var": "E" } }],
                     "config": { "type": { "kind": "dataType", "restrict": "array" },
                                 "default": { "type": "as-declared" } } },

    "control":     { "cat": "input",  "desc": "Terminal de un control numérico del panel",
                     "in": [], "out": [{ "name": "result", "type": "number" }],
                     "panel": true },
    "str-control": { "cat": "input",  "desc": "Terminal de un control de cadena",
                     "in": [], "out": [{ "name": "result", "type": "string" }],
                     "panel": true },
    "bool-control":{ "cat": "input",  "desc": "Terminal de un control booleano",
                     "in": [], "out": [{ "name": "result", "type": "boolean" }],
                     "panel": true },
    "arr-control": { "cat": "input",  "desc": "Terminal de un control de array",
                     "in": [], "out": [{ "name": "result", "type": { "var": "E" } }],
                     "panel": true, "type-from": "panel" },
    "cluster-control": { "cat": "cluster", "desc": "Terminal de un control de cluster",
                     "in": [], "out": [{ "name": "result", "type": { "var": "C" } }],
                     "panel": true, "type-from": "panel" },

    "indicator":     { "cat": "output", "desc": "Terminal de un indicador numérico",
                     "in": [{ "name": "value", "type": "number" }], "out": [],
                     "panel": true, "side-effect": true },
    "str-indicator": { "cat": "output", "desc": "Terminal de un indicador de cadena",
                     "in": [{ "name": "value", "type": "string" }], "out": [],
                     "panel": true, "side-effect": true },
    "bool-indicator":{ "cat": "output", "desc": "Terminal de un indicador booleano",
                     "in": [{ "name": "value", "type": "boolean" }], "out": [],
                     "panel": true, "side-effect": true },
    "arr-indicator": { "cat": "output", "desc": "Terminal de un indicador de array",
                     "in": [{ "name": "value", "type": { "array": { "var": "E" } } }], "out": [],
                     "panel": true, "side-effect": true },
    "cluster-indicator": { "cat": "cluster", "desc": "Terminal de un indicador de cluster",
                     "in": [{ "name": "value", "type": { "var": "C" } }], "out": [],
                     "panel": true, "type-from": "panel", "side-effect": true },

    "display":     { "cat": "output", "desc": "Imprime un valor por la salida estándar",
                     "in": [{ "name": "value", "type": "number" }], "out": [],
                     "side-effect": true },

    "add": {"cat": "numeric", "desc": "Suma", "in": [{"name": "a", "label": "x", "type": {"num": "N"}}, {"name": "b", "label": "y", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x+y", "type": {"num": "N"}}]},
    "sub": {"cat": "numeric", "desc": "Resta", "in": [{"name": "a", "label": "x", "type": {"num": "N"}}, {"name": "b", "label": "y", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x-y", "type": {"num": "N"}}]},
    "mul": {"cat": "numeric", "desc": "Multiplicación", "in": [{"name": "a", "label": "x", "type": {"num": "N"}}, {"name": "b", "label": "y", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x*y", "type": {"num": "N"}}]},
    "div": {"cat": "numeric", "desc": "División. Ver 04 §6 para división por cero. Con dos enteros da DBL", "in": [{"name": "a", "label": "x", "type": {"num": "N"}}, {"name": "b", "label": "y", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x/y", "type": {"num": "N", "flotante": true}}]},
    "quotient-remainder": {"cat": "numeric", "desc": "Cociente entero y resto: floor(x/y) y x-y*floor(x/y)", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}, {"name": "y", "label": "y", "type": {"num": "N"}}], "out": [{"name": "remainder", "label": "x-y*floor(x/y)", "type": {"num": "N"}}, {"name": "quotient", "label": "floor(x/y)", "type": {"num": "N"}}]},
    "increment": {"cat": "numeric", "desc": "Suma 1", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x+1", "type": {"num": "N"}}]},
    "decrement": {"cat": "numeric", "desc": "Resta 1", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x-1", "type": {"num": "N"}}]},
    "add-array-elements": {"cat": "numeric", "desc": "Suma de los elementos de un array", "in": [{"name": "numeric-array", "label": "numeric array", "type": {"array": {"num": "N"}}}], "out": [{"name": "sum", "label": "sum", "type": {"num": "N"}}]},
    "multiply-array-elements": {"cat": "numeric", "desc": "Producto de los elementos de un array; 1 si está vacío", "in": [{"name": "numeric-array", "label": "numeric array", "type": {"array": {"num": "N"}}}], "out": [{"name": "product", "label": "product", "type": {"num": "N"}}]},
    "compound-arithmetic": {"cat": "numeric", "desc": "Opera sobre un número variable de entradas: suma, multiplica, AND, OR o XOR. Las entradas se añaden y se quitan estirando el nodo o desde su menú; cada una, y la salida, se puede invertir", "in": "dynamic:compound-inputs", "out": [{"name": "result", "label": "result", "type": {"num": "N"}}], "dynamic-ports": true, "entradas": {"prefijo": "value-", "label": "value", "type": {"num": "N"}, "minimo": 2}, "modos": {"add": "+", "multiply": "×", "and": "∧", "or": "∨", "xor": "⊕"}, "modos-bit-a-bit": ["and", "or", "xor"], "config": {"inputs": {"type": "number", "value": 2}, "mode": {"type": "string", "value": "add"}, "inverted": {"type": "string", "value": []}}},
    "absolute-value": {"cat": "numeric", "desc": "Valor absoluto", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "abs(x)", "type": {"num": "N"}}]},
    "round-to-nearest": {"cat": "numeric", "desc": "Redondea al entero más cercano; en el punto medio, al par", "in": [{"name": "number", "label": "number", "type": {"num": "N"}}], "out": [{"name": "result", "label": "nearest integer value", "type": {"num": "N"}}]},
    "round-toward-negative-infinity": {"cat": "numeric", "desc": "Redondea al entero inferior", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "floor(x): largest int <= x", "type": {"num": "N"}}]},
    "round-toward-positive-infinity": {"cat": "numeric", "desc": "Redondea al entero superior", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "ceil(x): smallest int >= x", "type": {"num": "N"}}]},
    "scale-by-power-of-2": {"cat": "numeric", "desc": "Multiplica x por 2 elevado a n", "in": [{"name": "n", "label": "n", "type": "i32"}, {"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x*2^n", "type": {"num": "N"}}]},
    "square-root": {"cat": "numeric", "desc": "Raíz cuadrada. Con un entero da DBL", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "sqrt(x)", "type": {"num": "N", "flotante": true}}]},
    "square": {"cat": "numeric", "desc": "Cuadrado", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "x^2", "type": {"num": "N"}}]},
    "negate": {"cat": "numeric", "desc": "Cambia el signo", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "-x", "type": {"num": "N"}}]},
    "reciprocal": {"cat": "numeric", "desc": "Divide 1 entre la entrada. Con un entero da DBL", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "1/x", "type": {"num": "N", "flotante": true}}]},
    "sign": {"cat": "numeric", "desc": "Signo: -1, 0 o 1", "in": [{"name": "number", "label": "number", "type": {"num": "N"}}], "out": [{"name": "result", "label": "-1, 0, 1", "type": {"num": "N"}}]},
    "num-const": {"cat": "numeric", "desc": "Constante numérica de LabVIEW. Empieza en I32; al escribir en ella un número con decimales pasa a DBL", "in": [], "out": [{"name": "result", "label": "", "type": {"var": "E"}}], "config": {"type": {"kind": "dataType", "restrict": "numeric"}, "default": {"type": "i32", "value": 0}}, "type-from": "config"},
    "enum-const": {"cat": "numeric", "desc": "Constante enumerada: etiquetas con los valores 0 a n-1", "in": [], "out": [{"name": "result", "label": "", "type": {"var": "E"}}], "config": {"type": {"kind": "dataType", "restrict": "enum"}, "default": {"type": {"enum": []}, "value": 0}}, "type-from": "config"},
    "ring-const": {"cat": "numeric", "desc": "Constante de anillo: pares de valor y etiqueta", "in": [], "out": [{"name": "result", "label": "", "type": "u16"}], "config": {"items": {"type": "string", "value": []}, "default": {"type": "u16", "value": 0}}},
    "random-number": {"cat": "numeric", "desc": "Número aleatorio uniforme en [0, 1)", "in": [], "out": [{"name": "result", "label": "number (0 to 1)", "type": "number"}], "side-effect": true},
    "random-number-range": {"cat": "numeric", "desc": "Número aleatorio entre dos límites. En LabVIEW es polimórfico: U64, I64 o DBL según lo cableado", "in": [{"name": "lower-bound", "label": "lower bound", "type": {"num": "N"}}, {"name": "upper-bound", "label": "upper bound", "type": {"num": "N"}}], "out": [{"name": "result", "label": "random", "type": {"num": "N"}}], "side-effect": true},
    "positive-infinity": {"cat": "numeric", "desc": "Constante: +Inf", "in": [], "out": [{"name": "result", "label": "", "type": "number"}]},
    "negative-infinity": {"cat": "numeric", "desc": "Constante: -Inf", "in": [], "out": [{"name": "result", "label": "", "type": "number"}]},
    "machine-epsilon": {"cat": "numeric", "desc": "Constante: el épsilon de la máquina para DBL", "in": [], "out": [{"name": "result", "label": "", "type": "number"}]},
    "not-a-number": {"cat": "numeric", "desc": "Constante: NaN", "in": [], "out": [{"name": "result", "label": "", "type": "number"}]},
    "range-limits-for-type": {"cat": "numeric", "desc": "Máximo y mínimo del tipo cableado a type", "in": [{"name": "type", "label": "type", "type": {"num": "N"}}], "out": [{"name": "maximum", "label": "maximum value for type", "type": {"num": "N"}}, {"name": "minimum", "label": "minimum value for type", "type": {"num": "N"}}]},
    "expression-node": {"cat": "numeric", "desc": "Expresión de una sola variable escrita en el nodo", "in": [{"name": "x", "label": "x", "type": {"num": "N"}}], "out": [{"name": "result", "label": "result", "type": {"num": "N"}}], "config": {"expression": {"type": "string", "value": "x"}}},

    "and-op": { "cat": "logic", "desc": "Y lógico: TRUE si las dos entradas lo son; con enteros, bit a bit",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": "x .and. y?", "type": { "logico": "L" } }] },
    "or-op":  { "cat": "logic", "desc": "O lógico; con enteros, bit a bit",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": "x .or. y?", "type": { "logico": "L" } }] },
    "xor-op": { "cat": "logic", "desc": "O exclusivo: TRUE si sólo una de las entradas lo es; con enteros, bit a bit",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": "x .xor. y?", "type": { "logico": "L" } }] },
    "not-op": { "cat": "logic", "desc": "Negación; con enteros, bit a bit",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": ".not. x?", "type": { "logico": "L" } }] },
    "nand-op": { "cat": "logic", "desc": "Negación del Y lógico",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": ".not. (x .and. y)?", "type": { "logico": "L" } }] },
    "nor-op": { "cat": "logic", "desc": "Negación del O lógico",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": ".not. (x .or. y)?", "type": { "logico": "L" } }] },
    "nxor-op": { "cat": "logic", "desc": "Negación del O exclusivo",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": ".not. (x .xor. y)?", "type": { "logico": "L" } }] },
    "implies-op": { "cat": "logic", "desc": "Implicación: niega x y hace el O con y",
                "in": [{ "name": "x", "label": "x", "type": { "logico": "L" } }, { "name": "y", "label": "y", "type": { "logico": "L" } }],
                "out": [{ "name": "result", "label": "x .implies. y?", "type": { "logico": "L" } }] },
    "and-array-elements": { "cat": "logic", "desc": "TRUE si todos los elementos del array lo son, o si está vacío",
                "in": [{ "name": "boolean-array", "label": "Boolean array", "type": { "array": "boolean" } }],
                "out": [{ "name": "result", "label": "logical AND", "type": "boolean" }] },
    "or-array-elements": { "cat": "logic", "desc": "FALSE si todos los elementos del array lo son, o si está vacío",
                "in": [{ "name": "boolean-array", "label": "Boolean array", "type": { "array": "boolean" } }],
                "out": [{ "name": "result", "label": "logical OR", "type": "boolean" }] },
    "number-to-boolean-array": { "cat": "logic", "desc": "Convierte un entero en el array de sus bits; el elemento 0 es el bit menos significativo",
                "in": [{ "name": "number", "label": "number", "type": { "num": "N" } }],
                "out": [{ "name": "boolean-array", "label": "Boolean array", "type": { "array": "boolean" } }] },
    "boolean-array-to-number": { "cat": "logic", "desc": "Interpreta un array de booleanos como los bits de un entero; el primer elemento es el menos significativo",
                "in": [{ "name": "boolean-array", "label": "Boolean array", "type": { "array": "boolean" } }],
                "out": [{ "name": "number", "label": "number", "type": "i32" }] },
    "boolean-to-0-1": { "cat": "logic", "desc": "Convierte FALSE en 0 y TRUE en 1, un entero de 16 bits",
                "in": [{ "name": "boolean", "label": "Boolean", "type": "boolean" }],
                "out": [{ "name": "result", "label": "0, 1", "type": "i16" }] },

    "gt-op": { "cat": "compare", "desc": "Mayor que",
               "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
               "out": [{ "name": "result", "type": "boolean" }] },
    "lt-op": { "cat": "compare", "desc": "Menor que",
               "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
               "out": [{ "name": "result", "type": "boolean" }] },
    "eq-op": { "cat": "compare", "desc": "Igualdad",
               "in": [{ "name": "a", "type": "number" }, { "name": "b", "type": "number" }],
               "out": [{ "name": "result", "type": "boolean" }] },

    "concat":     { "cat": "string", "desc": "Concatena dos cadenas",
                    "in": [{ "name": "a", "type": "string" }, { "name": "b", "type": "string" }],
                    "out": [{ "name": "result", "type": "string" }] },
    "str-length": { "cat": "string", "desc": "Longitud de una cadena",
                    "in": [{ "name": "a", "type": "string" }],
                    "out": [{ "name": "result", "type": "number" }] },
    "to-string":  { "cat": "string", "desc": "Convierte un número a cadena. Ver 04 §6: el formato es comportamiento observable",
                    "in": [{ "name": "a", "type": "number" }],
                    "out": [{ "name": "result", "type": "string" }] },

    "build-array":  { "cat": "array", "desc": "Construye un array con dos elementos",
                      "in": [{ "name": "a", "type": { "var": "E" } }, { "name": "b", "type": { "var": "E" } }],
                      "out": [{ "name": "result", "type": { "array": { "var": "E" } } }] },
    "index-array":  { "cat": "array", "desc": "Elemento en la posición dada. Ver 04 §6 para índice fuera de rango",
                      "in": [{ "name": "arr", "type": { "array": { "var": "E" } } },
                             { "name": "index", "type": "number" }],
                      "out": [{ "name": "result", "type": { "var": "E" } }] },
    "array-size":   { "cat": "array", "desc": "Número de elementos",
                      "in": [{ "name": "arr", "type": { "array": { "var": "E" } } }],
                      "out": [{ "name": "result", "type": "number" }] },
    "array-subset": { "cat": "array", "desc": "Sub-array desde una posición y con una longitud",
                      "in": [{ "name": "arr", "type": { "array": { "var": "E" } } },
                             { "name": "start", "type": "number" },
                             { "name": "length", "type": "number" }],
                      "out": [{ "name": "result", "type": { "array": { "var": "E" } } }] },

    "bundle":   { "cat": "cluster", "desc": "Agrupa valores en un cluster. Un puerto de entrada por campo",
                  "in": "dynamic:cluster-fields", "out": [{ "name": "result", "type": { "var": "C" } }],
                  "dynamic-ports": true, "type-from": "config" },
    "unbundle": { "cat": "cluster", "desc": "Descompone un cluster. Un puerto de salida por campo",
                  "in": [{ "name": "value", "type": { "var": "C" } }], "out": "dynamic:cluster-fields",
                  "dynamic-ports": true, "type-from": "config" },

    "subvi": { "cat": "function", "desc": "Invoca otro VI. Sus puertos son el connector del VI llamado",
               "in": "dynamic:connector-inputs", "out": "dynamic:connector-outputs",
               "dynamic-ports": true, "config": { "vi": { "type": "string" } } },

    "while-loop":     { "cat": "structure", "desc": "Repite el cuerpo hasta que la condición es cierta",
                        "structure": true, "terminals": { "i": "number", "condition": "boolean" } },
    "for-loop":       { "cat": "structure", "desc": "Repite el cuerpo un número fijo de veces",
                        "structure": true, "terminals": { "i": "number", "count": "number" } },
    "case-structure": { "cat": "structure", "desc": "Ejecuta el marco que corresponde al selector",
                        "structure": true, "terminals": { "selector": ["number", "boolean", "string"] } },

    "tcp-open":  { "cat": "hardware", "desc": "Abre una conexión TCP. Requiere la capacidad `tcp`",
                   "in": [{ "name": "address", "type": "string", "default": "localhost" },
                          { "name": "remote-port", "type": "number", "default": 5000 },
                          { "name": "timeout-ms", "type": "number", "default": 60000 }],
                   "out": [{ "name": "connection-out", "type": "tcp-connection" }],
                   "side-effect": true, "capability": "tcp" },
    "tcp-write": { "cat": "hardware", "desc": "Escribe datos en una conexión abierta",
                   "in": [{ "name": "connection-in", "type": "tcp-connection" },
                          { "name": "data", "type": "string", "default": "" }],
                   "out": [{ "name": "connection-out", "type": "tcp-connection" },
                           { "name": "bytes-written", "type": "number" }],
                   "side-effect": true, "capability": "tcp" },
