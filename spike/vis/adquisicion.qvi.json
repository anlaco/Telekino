{
  "qvi": 1,
  "meta": {
    "name": "adquisicion",
    "description": "Un array que crece a través de las iteraciones (shift register de tipo puntero). La arena NO se puede resetear: el array sobrevive a la iteración."
  },
  "front-panel": [
    { "id": "limite",   "kind": "control",   "label": "Límite (i <)", "default": 9.0 },
    { "id": "muestras", "kind": "indicator", "label": "Muestras" },
    { "id": "total",    "kind": "indicator", "label": "Nº de muestras" }
  ],
  "diagram": {
    "nodes": [
      { "id": "lim",   "type": "control", "ref": "limite" },
      { "id": "vacio", "type": "build-array", "inputs": 0 },

      {
        "id": "w1",
        "type": "while",
        "shift-registers": [
          { "id": "buf", "init": ["vacio", "out"] }
        ],
        "condition": ["cmp", "out"],
        "body": {
          "nodes": [
            { "id": "lee",  "type": "sr-read", "sr": "buf" },
            { "id": "i",    "type": "iter" },
            { "id": "diez", "type": "const", "value": 10.0 },
            { "id": "val",  "type": "mul" },
            { "id": "app",  "type": "array-append" },
            { "id": "esc",  "type": "sr-write", "sr": "buf" },
            { "id": "tlim", "type": "tunnel", "src": ["lim", "out"] },
            { "id": "cmp",  "type": "lt" }
          ],
          "wires": [
            { "from": ["i",    "out"], "to": ["val", "a"] },
            { "from": ["diez", "out"], "to": ["val", "b"] },
            { "from": ["lee",  "out"], "to": ["app", "arr"] },
            { "from": ["val",  "out"], "to": ["app", "v"] },
            { "from": ["app",  "out"], "to": ["esc", "in"] },
            { "from": ["i",    "out"], "to": ["cmp", "a"] },
            { "from": ["tlim", "out"], "to": ["cmp", "b"] }
          ]
        }
      },

      { "id": "fin",  "type": "sr-read", "sr": "buf" },
      { "id": "sz",   "type": "array-size" },
      { "id": "out1", "type": "indicator", "ref": "muestras" },
      { "id": "out2", "type": "indicator", "ref": "total" }
    ],
    "wires": [
      { "from": ["fin", "out"], "to": ["sz",   "arr"] },
      { "from": ["fin", "out"], "to": ["out1", "in"] },
      { "from": ["sz",  "out"], "to": ["out2", "in"] }
    ]
  }
}
